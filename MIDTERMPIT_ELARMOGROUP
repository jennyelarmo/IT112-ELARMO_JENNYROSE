#include <stdio.h>

#define MAX_EXPENSES 100

void displayExpenses(char names[][50], float amounts[], int count) {
    int i;
    printf("\n===== EXPENSE RECORDS =====\n");
    
    if (count == 0) {
        printf("No expenses recorded.\n");
    } else {
        for (i = 0; i < count; i++) {
            printf("%d. %-20s PHP %.2f\n", i + 1, names[i], amounts[i]);
        }
    }
}

void displaySummary(float budget, float total) {
    float remaining = budget - total;
    printf("\n===== EXPENSES SUMMARY =====\n");
    printf("Daily Budget:    PHP %.2f\n", budget);
    printf("Total Expenses:  PHP %.2f\n", total);
    printf("Remaining:       PHP %.2f\n", remaining);
}

void displayBudgetStatus(float remaining) {
    int status;
    
    if (remaining < 0) {
        status = 1;
    } else if (remaining == 0) {
        status = 2;
    } else {
        status = 3;
    }
    
    printf("\n===== BUDGET STATUS =====\n");
    
    switch (status) {
        case 1:
            printf("Budget Exceeded!\n");
            break;
        case 2:
            printf("You used your entire budget!\n");
            break;
        case 3:
            printf("Within Budget!\n");
            break;
        default:
            printf("Invalid status.\n");
            break;
    }
}

int main() {
    char names[MAX_EXPENSES][50];
    float amounts[MAX_EXPENSES];
    float budget, amount, totalExpenses = 0, remaining;
    int choice = 0, expenseCount = 0;

    printf("====================================\n");
    printf("       DAILY EXPENSES TRACKER       \n");
    printf("====================================\n");

    printf("\nEnter your daily budget: PHP ");
    scanf("%f", &budget);
    
    while (budget <= 0) {
        printf("Invalid! Enter a positive amount: PHP ");
        scanf("%f", &budget);
    }

    do {
        if (expenseCount >= MAX_EXPENSES) {
            printf("\nMaximum of %d expenses reached.\n", MAX_EXPENSES);
            break;
        }

        printf("\nEnter expense name: ");
        scanf("%s", names[expenseCount]);
        
        printf("Enter amount: PHP ");
        scanf("%f", &amount);

        if (amount < 0) {
            printf("Invalid! Amount cannot be negative.\n");
            continue;
        }

        amounts[expenseCount] = amount;
        totalExpenses += amount;
        expenseCount++;
        printf("Expense added successfully!\n");

        printf("\nAdd another expense? (1=Yes, 0=No): ");
        scanf("%d", &choice);
        
        while (choice != 0 && choice != 1) {
            printf("Please enter only 1 or 0: ");
            scanf("%d", &choice);
        }

    } while (choice == 1);

    displayExpenses(names, amounts, expenseCount);

    if (expenseCount > 0) {
        printf("\n===== SAVED RECORDS =====\n");
        for (int i = 1; i <= expenseCount; i++) {
            printf("Expense record %d saved.\n", i);
        }
    }

    remaining = budget - totalExpenses;
    displaySummary(budget, totalExpenses);
    displayBudgetStatus(remaining);

    printf("\nThank you for using Daily Expenses Tracker!\n");
    return 0;
}
